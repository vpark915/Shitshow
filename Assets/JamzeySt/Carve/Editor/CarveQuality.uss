/* Carve Quality Manager inspector: the Hub's tokens and building blocks (CarveHub.uss), sized for the Inspector. */

.carve-quality {
    margin: 4px 0 2px 0;
    border-radius: 8px;
    border-width: 1px;
    border-color: var(--border);
    overflow: hidden;
}

.carve-quality .hub-header {
    padding: 10px 12px;
}

.carve-quality .hub-logo {
    width: 24px;
    height: 24px;
    margin-right: 10px;
}

.carve-quality .hub-wordmark {
    font-size: 14px;
    letter-spacing: 4px;
}

.carve-quality .hub-pill {
    margin-left: 4px;
    padding: 2px 8px;
    font-size: 10px;
}

.quality-page {
    padding: 12px 12px 0 12px;
}

.carve-quality .hub-card {
    margin-bottom: 10px;
}

.carve-quality .hub-card-header {
    padding: 9px 12px;
}

.carve-quality .hub-card-content {
    padding: 0 12px 12px 12px;
}

.carve-quality .setting-label {
    width: 104px;
}

.carve-quality .setting-row {
    padding: 6px 0;
}

/* Full-width segmented control: every segment shares the row. */
.quality-fill .segmented {
    flex-grow: 1;
}

.quality-fill .segment {
    flex-grow: 1;
    flex-basis: 0;
    padding: 4px 2px;
    -unity-text-align: middle-center;
}

.quality-callout {
    margin-top: 10px;
}

.quality-actions {
    flex-direction: row;
    margin-top: 10px;
}

.quality-locked {
    margin: 0 0 4px 0;
}

/* Sliders and number fields in the Hub colours. */
.quality-slider {
    flex-grow: 1;
    flex-shrink: 1;
    margin: 0;
}

.carve-quality .unity-base-slider__tracker {
    background-color: var(--surface-3);
    border-color: var(--border-strong);
}

.carve-quality .unity-base-slider__dragger {
    background-color: var(--accent);
    border-color: var(--accent);
}

.carve-quality .unity-base-slider__dragger-border {
    border-color: var(--accent-strong);
}

.carve-quality .unity-base-slider__text-field {
    width: 46px;
    margin-left: 8px;
}

.carve-quality .unity-base-text-field__input {
    background-color: var(--surface-2);
    border-color: var(--border-strong);
    color: var(--text);
    border-radius: 4px;
}

.quality-number {
    width: 64px;
    margin: 0;
}

.quality-unit {
    margin-left: 6px;
    color: var(--faint);
    font-size: 11px;
}

/* Live readout. */
.quality-stats {
    flex-direction: row;
    flex-wrap: wrap;
    margin-right: -8px;
}

.quality-stat {
    flex-grow: 1;
    flex-basis: 110px;
    margin: 0 8px 8px 0;
    padding: 9px 11px;
    border-radius: 6px;
    border-width: 1px;
    border-color: var(--border);
    background-color: var(--surface-2);
}

.quality-stat-value {
    font-size: 16px;
    -unity-font-style: bold;
}

.quality-stat-label {
    color: var(--muted);
    font-size: 10.5px;
}

.quality-stat--ok .quality-stat-value {
    color: var(--ok);
}

.quality-stat--warn .quality-stat-value {
    color: var(--warn);
}

.quality-meter {
    height: 6px;
    margin-top: 7px;
    border-radius: 3px;
    background-color: var(--surface-3);
}

.quality-meter-fill {
    height: 100%;
    border-radius: 3px;
    background-color: var(--accent);
}
