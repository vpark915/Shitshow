/* ---------- Tokens */

.carve-hub {
    --bg: #15171B;
    --surface: #1D2026;
    --surface-2: #252930;
    --surface-3: #2E333B;
    --border: #2C3139;
    --border-strong: #3B414B;
    --text: #E8EAED;
    --muted: #9AA3AE;
    --faint: #6B7480;
    --accent: #E8A04F;
    --accent-strong: #F2B266;
    --accent-dim: rgba(232, 160, 79, 0.14);
    --accent-text: #17191D;
    --ok: #4CC38A;
    --ok-dim: rgba(76, 195, 138, 0.12);
    --info: #4DA3FF;
    --warn: #F2B84B;
    --warn-dim: rgba(242, 184, 75, 0.14);
    --error: #F06A6A;
    --error-dim: rgba(240, 106, 106, 0.14);
    flex-grow: 1;
    background-color: var(--bg);
    color: var(--text);
    font-size: 12px;
}

.carve-hub--light {
    --bg: #E3E5E8;
    --surface: #F5F6F7;
    --surface-2: #ECEEF0;
    --surface-3: #E1E4E8;
    --border: #D2D6DB;
    --border-strong: #BCC1C8;
    --text: #1C1F24;
    --muted: #59616C;
    --faint: #848C96;
    --accent: #C26F22;
    --accent-strong: #AD611B;
    --accent-dim: rgba(194, 111, 34, 0.13);
    --accent-text: #FFFFFF;
}

/* Icons read --icon-color (Painter2D), so each state sets it explicitly. */
.carve-icon {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
    --icon-color: #9AA3AE;
}

.carve-hub--light .carve-icon {
    --icon-color: #59616C;
}

/* ---------- Header */

.hub-header {
    flex-direction: row;
    align-items: center;
    padding: 10px 16px;
    background-color: var(--surface);
    border-bottom-width: 1px;
    border-bottom-color: var(--border);
}

.hub-logo {
    width: 30px;
    height: 30px;
    margin-right: 12px;
    flex-shrink: 0;
    --logo-color: #E8A04F;
    --logo-cut: #1D2026;
}

.carve-hub--light .hub-logo {
    --logo-color: #C26F22;
    --logo-cut: #F5F6F7;
}

.hub-brand {
    flex-shrink: 1;
}

.hub-wordmark {
    font-size: 18px;
    -unity-font-style: bold;
    letter-spacing: 5px;
    color: var(--text);
}

.hub-slogan {
    font-size: 11px;
    color: var(--muted);
    margin-top: 1px;
}

.hub-spacer {
    flex-grow: 1;
}

.hub-pills {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
}

.hub-pill {
    flex-direction: row;
    align-items: center;
    margin-left: 6px;
    padding: 3px 10px;
    border-radius: 11px;
    border-width: 1px;
    border-color: var(--border-strong);
    background-color: var(--surface-2);
    color: var(--muted);
    font-size: 11px;
    -unity-font-style: bold;
}

.hub-pill--health {
    cursor: link;
    transition-duration: 0.12s;
}

.hub-pill--health:hover {
    border-color: var(--accent);
}

.hub-pill-dot {
    width: 7px;
    height: 7px;
    margin-right: 6px;
    border-radius: 4px;
    background-color: var(--faint);
}

.hub-pill-text {
    padding: 0;
    margin: 0;
}

.hub-pill--ok {
    color: var(--ok);
    background-color: var(--ok-dim);
    border-color: rgba(76, 195, 138, 0.35);
}

.hub-pill--ok .hub-pill-dot {
    background-color: var(--ok);
}

.hub-pill--warn {
    color: var(--warn);
    background-color: var(--warn-dim);
    border-color: rgba(242, 184, 75, 0.4);
}

.hub-pill--warn .hub-pill-dot {
    background-color: var(--warn);
}

.hub-pill--error {
    color: var(--error);
    background-color: var(--error-dim);
    border-color: rgba(240, 106, 106, 0.4);
}

.hub-pill--error .hub-pill-dot {
    background-color: var(--error);
}

.carve-hub--narrow .hub-slogan {
    display: none;
}

/* ---------- Sidebar */

.hub-body {
    flex-direction: row;
    flex-grow: 1;
}

.hub-nav {
    width: 176px;
    flex-shrink: 0;
    padding-bottom: 8px;
    background-color: var(--surface);
    border-right-width: 1px;
    border-right-color: var(--border);
}

.hub-nav-toggle {
    align-self: flex-end;
    width: 26px;
    height: 22px;
    margin: 8px 8px 0 8px;
    align-items: center;
    justify-content: center;
    border-radius: 5px;
    cursor: link;
    transition-duration: 0.12s;
}

.hub-nav-toggle:hover {
    background-color: var(--surface-2);
}

.nav-toggle-icon {
    width: 12px;
    height: 12px;
}

.hub-nav-section {
    margin: 10px 18px 4px 18px;
    font-size: 10px;
    letter-spacing: 1.5px;
    -unity-font-style: bold;
    color: var(--faint);
}

.hub-nav-item {
    flex-direction: row;
    align-items: center;
    height: 32px;
    margin: 1px 8px;
    padding: 0 10px;
    border-radius: 6px;
    cursor: link;
    transition-duration: 0.12s;
}

.hub-nav-item:hover {
    background-color: var(--surface-2);
}

.nav-marker {
    position: absolute;
    left: 0;
    top: 8px;
    width: 3px;
    height: 16px;
    border-radius: 2px;
}

.nav-icon {
    margin-right: 10px;
}

.nav-label {
    flex-grow: 1;
    color: var(--muted);
    -unity-font-style: bold;
}

.hub-nav-item:hover .nav-label {
    color: var(--text);
}

.hub-nav-item:hover .nav-icon {
    --icon-color: #E8EAED;
}

.carve-hub--light .hub-nav-item:hover .nav-icon {
    --icon-color: #1C1F24;
}

.hub-nav-item--selected {
    background-color: var(--accent-dim);
}

.hub-nav-item--selected:hover {
    background-color: var(--accent-dim);
}

.hub-nav-item--selected .nav-marker {
    background-color: var(--accent);
}

.hub-nav-item--selected .nav-label {
    color: var(--accent);
}

.hub-nav-item--selected .nav-icon,
.hub-nav-item--selected:hover .nav-icon {
    --icon-color: #E8A04F;
}

.carve-hub--light .hub-nav-item--selected .nav-icon,
.carve-hub--light .hub-nav-item--selected:hover .nav-icon {
    --icon-color: #C26F22;
}

.carve-hub--light .hub-nav-item--selected .nav-label {
    color: var(--accent);
}

.nav-badge {
    min-width: 18px;
    height: 16px;
    padding: 0 5px;
    border-radius: 8px;
    background-color: var(--surface-3);
    color: var(--muted);
    font-size: 10px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.nav-badge--alert {
    background-color: var(--warn);
    color: #17191D;
}

.nav-badge--hidden {
    display: none;
}

.hub-nav-foot {
    margin: 0 18px;
    padding-top: 10px;
    border-top-width: 1px;
    border-top-color: var(--border);
}

.nav-foot-text {
    font-size: 10px;
    color: var(--faint);
}

.hub-nav--collapsed {
    width: 52px;
}

.hub-nav--collapsed .hub-nav-toggle {
    align-self: center;
    margin: 8px 0 0 0;
}

.hub-nav--collapsed .hub-nav-section {
    height: 1px;
    margin: 10px 14px 6px 14px;
    font-size: 1px;
    color: rgba(0, 0, 0, 0);
    background-color: var(--border);
}

.hub-nav--collapsed .hub-nav-item {
    margin: 1px 6px;
    padding: 0;
    justify-content: center;
}

.hub-nav--collapsed .nav-icon {
    margin-right: 0;
}

.hub-nav--collapsed .nav-label,
.hub-nav--collapsed .nav-badge,
.hub-nav--collapsed .hub-nav-foot {
    display: none;
}

/* ---------- Page */

.hub-content {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
}

.page-header {
    flex-direction: row;
    align-items: center;
    padding: 14px 20px 12px 20px;
    border-bottom-width: 1px;
    border-bottom-color: var(--border);
}

.page-icon {
    width: 22px;
    height: 22px;
    margin-right: 12px;
    --icon-color: #E8A04F;
}

.carve-hub--light .page-icon {
    --icon-color: #C26F22;
}

.page-titles {
    flex-grow: 1;
    flex-shrink: 1;
}

.page-title {
    font-size: 16px;
    -unity-font-style: bold;
}

.page-desc {
    margin-top: 2px;
    color: var(--muted);
    white-space: normal;
}

.page-actions {
    flex-direction: row;
    margin-left: 12px;
}

.hub-scroll {
    flex-grow: 1;
}

.hub-page {
    padding: 16px 20px 8px 20px;
}

/* ---------- Cards */

.hub-card {
    margin-bottom: 14px;
    border-radius: 8px;
    border-width: 1px;
    border-color: var(--border);
    background-color: var(--surface);
}

.hub-card-header {
    flex-direction: row;
    align-items: center;
    padding: 11px 14px;
    cursor: link;
}

.hub-card-chevron {
    width: 10px;
    height: 10px;
    margin-right: 10px;
    rotate: 90deg;
    transition-duration: 0.15s;
    --icon-color: #6B7480;
}

.hub-card--collapsed .hub-card-chevron {
    rotate: 0deg;
}

.hub-card-titles {
    flex-grow: 1;
    flex-shrink: 1;
}

.hub-card-title {
    font-size: 13px;
    -unity-font-style: bold;
}

.hub-card-subtitle {
    margin-top: 1px;
    font-size: 11px;
    color: var(--muted);
    white-space: normal;
}

.hub-card-actions {
    flex-direction: row;
    align-items: center;
}

.hub-card-actions > .hub-button {
    margin: 0 0 0 6px;
}

.hub-card-content {
    padding: 0 14px 14px 14px;
}

.hub-card--collapsed .hub-card-content {
    display: none;
}

.hub-grid {
    flex-direction: row;
    flex-wrap: wrap;
    margin-right: -14px;
}

.grid-cell {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 320px;
    margin-right: 14px;
}

.card-footer {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    margin-top: 10px;
    padding-top: 12px;
    border-top-width: 1px;
    border-top-color: var(--border);
}

.card-footer > .hub-button {
    margin-bottom: 4px;
}

.hub-text {
    white-space: normal;
    color: var(--muted);
    margin-bottom: 8px;
}

.hub-note {
    white-space: normal;
    color: var(--faint);
    font-size: 11px;
    margin-top: 6px;
}

.hub-field {
    margin: 0 0 6px 0;
}

.hub-field > .unity-base-field__label {
    min-width: 120px;
    width: 120px;
    color: var(--muted);
    -unity-font-style: bold;
}

.list-label {
    margin: 14px 0 4px 0;
    font-size: 10px;
    letter-spacing: 1.2px;
    -unity-font-style: bold;
    color: var(--faint);
}

/* ---------- Buttons and controls */

.hub-button {
    margin: 0 6px 0 0;
    padding: 4px 12px;
    border-radius: 5px;
    border-width: 1px;
    border-color: var(--border-strong);
    background-color: var(--surface-2);
    color: var(--text);
    transition-duration: 0.12s;
}

.hub-button:hover {
    background-color: var(--surface-3);
    border-color: var(--accent);
}

.hub-button:disabled {
    opacity: 0.45;
}

.hub-button--primary {
    background-color: var(--accent);
    border-color: var(--accent);
    color: var(--accent-text);
    -unity-font-style: bold;
}

.hub-button--primary:hover {
    background-color: var(--accent-strong);
    border-color: var(--accent-strong);
}

.hub-button--small {
    padding: 2px 9px;
    font-size: 11px;
}

.hub-icon-button {
    width: 24px;
    height: 22px;
    margin-right: 6px;
    align-items: center;
    justify-content: center;
    border-radius: 5px;
    border-width: 1px;
    border-color: var(--border-strong);
    background-color: var(--surface-2);
    cursor: link;
    transition-duration: 0.12s;
}

.hub-icon-button:hover {
    border-color: var(--accent);
}

.hub-icon-button-glyph {
    width: 11px;
    height: 11px;
}

.carve-hub--narrow .hub-icon-button-glyph {
    rotate: 90deg;
}

.segmented {
    flex-direction: row;
    margin: 2px 0;
}

.segment {
    margin: 0;
    padding: 4px 12px;
    border-radius: 0;
    border-width: 1px;
    border-left-width: 0;
    border-color: var(--border-strong);
    background-color: var(--surface-2);
    color: var(--muted);
    transition-duration: 0.12s;
}

.segment:hover {
    background-color: var(--surface-3);
    color: var(--text);
}

.segment--first {
    border-left-width: 1px;
    border-top-left-radius: 5px;
    border-bottom-left-radius: 5px;
}

.segment--last {
    border-top-right-radius: 5px;
    border-bottom-right-radius: 5px;
}

.segment--active {
    background-color: var(--accent-dim);
    color: var(--accent);
    -unity-font-style: bold;
}

.segment--active:hover {
    background-color: var(--accent-dim);
    color: var(--accent);
}

.setting-row {
    flex-direction: row;
    align-items: center;
    padding: 8px 0;
    border-top-width: 1px;
    border-top-color: var(--border);
}

.setting-row--first {
    border-top-width: 0;
}

.setting-label {
    width: 92px;
    flex-shrink: 0;
    color: var(--muted);
    -unity-font-style: bold;
}

.setting-controls {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    flex-grow: 1;
    flex-shrink: 1;
}

.setting-hint {
    margin-left: 10px;
    color: var(--faint);
    font-size: 11px;
}

.setting-value {
    margin-right: 10px;
    color: var(--text);
}

.chip-toggle {
    margin: 2px 6px 2px 0;
    padding: 3px 10px 3px 8px;
    border-radius: 12px;
    border-width: 1px;
    border-color: var(--border-strong);
    background-color: var(--surface-2);
    transition-duration: 0.12s;
}

.chip-toggle:hover {
    border-color: var(--accent);
}

.chip-toggle:checked {
    border-color: var(--accent);
    background-color: var(--accent-dim);
}

.chip-toggle .unity-toggle__text {
    margin-left: 4px;
    color: var(--text);
}

.chip-grid {
    flex-direction: row;
    flex-wrap: wrap;
    margin-bottom: 8px;
}

.chip {
    margin: 0 6px 6px 0;
    padding: 4px 11px;
    border-radius: 13px;
    border-width: 1px;
    border-color: var(--border-strong);
    background-color: var(--surface-2);
    color: var(--muted);
    transition-duration: 0.12s;
}

.chip:hover {
    color: var(--text);
    border-color: var(--accent);
}

.chip--active {
    background-color: var(--accent);
    border-color: var(--accent);
    color: var(--accent-text);
    -unity-font-style: bold;
}

.chip--active:hover {
    color: var(--accent-text);
}

.callout {
    padding: 9px 12px;
    border-radius: 6px;
    border-left-width: 3px;
    border-left-color: var(--accent);
    background-color: var(--surface-2);
}

.callout-title {
    -unity-font-style: bold;
    margin-bottom: 2px;
}

.callout-text {
    color: var(--muted);
    white-space: normal;
}

.tag {
    padding: 1px 6px;
    border-radius: 4px;
    border-width: 1px;
    border-color: var(--border-strong);
    background-color: var(--surface-2);
    color: var(--muted);
    font-size: 10px;
}

.tag--accent {
    border-color: var(--accent);
    background-color: var(--accent-dim);
    color: var(--accent);
}

.result-block {
    margin: 4px 0 2px 0;
    padding: 10px 12px;
    border-radius: 6px;
    background-color: var(--surface-2);
    white-space: normal;
}

/* ---------- Dashboard */

.stat-row {
    flex-direction: row;
    flex-wrap: wrap;
    margin-right: -10px;
    margin-bottom: 4px;
}

.stat-tile {
    flex-direction: row;
    align-items: center;
    flex-grow: 1;
    flex-basis: 150px;
    margin: 0 10px 10px 0;
    padding: 12px 14px;
    border-radius: 8px;
    border-width: 1px;
    border-color: var(--border);
    background-color: var(--surface);
    transition-duration: 0.12s;
}

.stat-tile--link {
    cursor: link;
}

.stat-tile--link:hover {
    border-color: var(--accent);
}

.stat-icon {
    width: 22px;
    height: 22px;
    margin-right: 12px;
    --icon-color: #E8A04F;
}

.carve-hub--light .stat-icon {
    --icon-color: #C26F22;
}

.stat-text {
    flex-shrink: 1;
}

.stat-value {
    font-size: 18px;
    -unity-font-style: bold;
}

.stat-label {
    color: var(--muted);
    font-size: 10.5px;
    white-space: normal;
}

.check-row {
    flex-direction: row;
    align-items: center;
}

.check-row--issue {
    padding: 10px 0;
    border-bottom-width: 1px;
    border-bottom-color: var(--border);
}

.check-dot {
    width: 9px;
    height: 9px;
    margin-right: 12px;
    border-radius: 5px;
    flex-shrink: 0;
}

.check-dot--ok {
    background-color: var(--ok);
}

.check-dot--info {
    background-color: var(--info);
}

.check-dot--warning {
    background-color: var(--warn);
}

.check-dot--error {
    background-color: var(--error);
}

.check-body {
    flex-grow: 1;
    flex-shrink: 1;
}

.check-title {
    -unity-font-style: bold;
}

.check-detail {
    white-space: normal;
    color: var(--muted);
    font-size: 11px;
    margin-top: 1px;
}

.check-fix {
    margin: 0 0 0 10px;
}

.check-row--passed {
    padding: 3px 0;
}

.check-tick {
    width: 12px;
    height: 12px;
    margin-right: 10px;
    --icon-color: #4CC38A;
}

.check-passed-title {
    color: var(--muted);
}

.health-ok {
    flex-direction: row;
    align-items: center;
    padding: 10px 12px;
    border-radius: 6px;
    background-color: var(--ok-dim);
}

.health-ok-icon {
    width: 14px;
    height: 14px;
    margin-right: 10px;
    --icon-color: #4CC38A;
}

.health-ok-text {
    color: var(--ok);
    -unity-font-style: bold;
}

.action-grid {
    flex-direction: row;
    flex-wrap: wrap;
    margin-right: -8px;
}

.action-tile {
    flex-direction: row;
    align-items: center;
    flex-grow: 1;
    flex-basis: 190px;
    margin: 0 8px 8px 0;
    padding: 10px 12px;
    border-radius: 6px;
    border-width: 1px;
    border-color: var(--border);
    background-color: var(--surface-2);
    cursor: link;
    transition-duration: 0.12s;
}

.action-tile:hover {
    border-color: var(--accent);
    background-color: var(--surface-3);
}

.action-icon {
    width: 18px;
    height: 18px;
    margin-right: 11px;
    --icon-color: #E8A04F;
}

.carve-hub--light .action-icon {
    --icon-color: #C26F22;
}

.action-text {
    flex-shrink: 1;
}

.action-title {
    -unity-font-style: bold;
}

.action-detail {
    color: var(--muted);
    font-size: 10.5px;
    white-space: normal;
}

/* ---------- Materials */

.mat-page {
    flex-grow: 1;
}

.mat-split {
    flex-grow: 1;
}

.mat-split .unity-two-pane-split-view__dragline-anchor {
    background-color: var(--border);
}

.mat-split .unity-two-pane-split-view__dragline-anchor:hover {
    background-color: var(--accent);
}

.mat-left {
    padding: 12px 8px 12px 16px;
    min-width: 0;
}

.mat-right {
    flex-grow: 1;
}

.mat-right .unity-scroll-view__content-container {
    padding: 12px 20px 12px 10px;
}

.hub-toolbar {
    flex-direction: row;
    align-items: center;
}

.hub-search {
    flex-grow: 1;
    flex-shrink: 1;
    width: auto;
    margin: 0;
}

.list-filter {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin: 8px 0;
}

.list-count {
    color: var(--faint);
    font-size: 11px;
}

.mat-list {
    flex-grow: 1;
    min-height: 80px;
    border-radius: 8px;
    border-width: 1px;
    border-color: var(--border);
    background-color: var(--surface);
}

.mat-list .unity-collection-view__item--selected {
    background-color: var(--accent-dim);
}

.mat-item {
    flex-direction: row;
    align-items: center;
    flex-grow: 1;
    padding: 0 10px;
}

.mat-thumb {
    width: 32px;
    height: 32px;
    margin-right: 10px;
    border-radius: 5px;
    flex-shrink: 0;
    background-color: var(--surface-2);
}

.mat-texts {
    flex-grow: 1;
    flex-shrink: 1;
    overflow: hidden;
}

.mat-name {
    -unity-font-style: bold;
    overflow: hidden;
    text-overflow: ellipsis;
}

.mat-info {
    color: var(--muted);
    font-size: 10.5px;
    overflow: hidden;
    text-overflow: ellipsis;
}

.mat-tag {
    margin-left: 8px;
    padding: 1px 5px;
    border-radius: 3px;
    border-width: 1px;
    border-color: var(--border-strong);
    color: var(--faint);
    font-size: 9px;
    letter-spacing: 0.5px;
    -unity-font-style: bold;
    flex-shrink: 0;
}

.list-hidden-bar {
    flex-direction: row;
    align-items: center;
    margin-bottom: 12px;
}

.list-hidden-text {
    flex-shrink: 1;
    color: var(--muted);
    overflow: hidden;
    text-overflow: ellipsis;
}

.mat-inspector {
    margin: 0 -6px;
}

/* ---------- Convert */

.convert-row {
    flex-direction: row;
    align-items: flex-start;
    padding: 10px 0;
    border-bottom-width: 1px;
    border-bottom-color: var(--border);
}

.convert-toggle {
    margin: 1px 8px 0 0;
}

.convert-body {
    flex-grow: 1;
    flex-shrink: 1;
}

.convert-head {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    margin-bottom: 3px;
}

.convert-name {
    margin-right: 10px;
    -unity-font-style: bold;
    cursor: link;
}

.convert-arrow {
    margin: 0 6px;
    color: var(--faint);
}

.convert-lost {
    color: var(--warn);
}

/* ---------- Tables, steps, empty states */

.table-row {
    flex-direction: row;
    align-items: center;
    padding: 6px 0;
    border-bottom-width: 1px;
    border-bottom-color: var(--border);
}

.table-icon {
    width: 14px;
    height: 14px;
    margin-right: 10px;
}

.table-name {
    flex-grow: 1;
    flex-shrink: 1;
    overflow: hidden;
    text-overflow: ellipsis;
}

.table-meta {
    margin-right: 10px;
    color: var(--faint);
    font-size: 11px;
}

.step {
    flex-direction: row;
    align-items: flex-start;
    margin-bottom: 9px;
}

.step-number {
    width: 20px;
    height: 20px;
    margin-right: 10px;
    flex-shrink: 0;
    border-radius: 10px;
    background-color: var(--accent-dim);
    color: var(--accent);
    font-size: 11px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.step-text {
    flex-shrink: 1;
    padding-top: 2px;
    white-space: normal;
}

.empty-state {
    align-items: center;
    padding: 40px 20px;
}

.empty-icon {
    width: 40px;
    height: 40px;
    margin-bottom: 14px;
    --icon-color: #6B7480;
}

.empty-title {
    font-size: 14px;
    -unity-font-style: bold;
    margin-bottom: 4px;
}

.empty-text {
    max-width: 380px;
    color: var(--muted);
    white-space: normal;
    -unity-text-align: middle-center;
}

.empty-actions {
    flex-direction: row;
    margin-top: 16px;
}

/* ---------- Setup Wizard */

.setup-banner {
    height: 170px;
    flex-shrink: 0;
    -unity-background-scale-mode: scale-and-crop;
    background-position-y: bottom;
    border-bottom-width: 1px;
    border-bottom-color: var(--border);
}

.setup-intro {
    margin-bottom: 14px;
}

.setup-foot {
    font-size: 10.5px;
    color: var(--faint);
}
